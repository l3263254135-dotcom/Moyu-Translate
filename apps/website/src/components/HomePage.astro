---
import { MoyuMark } from "@moyu/ui";
import { BookOpen, Gamepad2, Image, LockKeyhole, MonitorPlay, MousePointer2, ScanText, Star, Volume2 } from "lucide-react";
import manifestData from "../../public/release-manifest.json";
import type { ReleaseManifest } from "@moyu/contracts";
import BaseLayout from "../layouts/BaseLayout.astro";
import { DownloadButtons } from "./DownloadButtons";
import { HeroDemo } from "./HeroDemo";
import { withBase } from "../lib/paths";

const { lang } = Astro.props as { lang: "zh" | "en" };
const zh = lang === "zh";
const manifest = manifestData as ReleaseManifest;
const base = import.meta.env.BASE_URL;
const root = withBase(base);
const englishRoot = withBase(base, "en");
const copy = zh ? {
  title: "Moyu Translate - macOS 与 Windows 本地悬浮翻译",
  description: "光标停在文字上，长按 Option 或 Alt 即刻翻译。精致悬浮卡片展示英美双音、自动发音、本地词典和离线模型，不打断你的阅读节奏。",
  nav: ["功能", "场景", "词典", "隐私", "下载"],
  heroLead: "停一下，就懂了。",
  heroBody: "光标停在任意文字上，长按 Option 或 Alt。无需选中、复制或切换窗口，Moyu 用一张精致悬浮卡片给出释义、英美音标和本地朗读。",
  featureTitle: "翻译应该贴着你的节奏走",
  featureBody: "阅读论文、看字幕或进入游戏时，你只需要理解眼前这一处。Moyu 把取词、释义、英美双音和离线能力压缩成一个按键和一块安静的悬浮窗。",
} : {
  title: "Moyu Translate - Local hover translation for macOS and Windows",
  description: "Hover over text and hold Option or Alt to translate instantly with a polished floating card, UK/US pronunciation, local dictionaries and offline models.",
  nav: ["Features", "Scenarios", "Dictionary", "Privacy", "Download"],
  heroLead: "Pause. Understand. Continue.",
  heroBody: "Hover over any text and hold Option or Alt. No selecting, copying or context switching. Moyu shows the meaning, UK/US pronunciation and local speech in one polished card.",
  featureTitle: "Translation that follows your pace",
  featureBody: "When you are reading a paper, watching subtitles or playing a game, you only need the line in front of you. Moyu turns capture, meaning, UK/US pronunciation and offline lookup into one quiet floating panel.",
};
---
<BaseLayout lang={zh ? "zh-CN" : "en"} title={copy.title} description={copy.description} path={zh ? "/" : "/en/"}>
  <header class="site-header">
    <nav aria-label={zh ? "主导航" : "Main navigation"}>
      <a class="brand" href={zh ? root : englishRoot}><MoyuMark /><strong>Moyu Translate</strong></a>
      <div class="nav-links">
        {copy.nav.map((item, index) => <a href={["#features", "#scenarios", "#dictionary", "#privacy", "#download"][index]}>{item}</a>)}
      </div>
      <a class="language-link" href={zh ? englishRoot : root}>{zh ? "EN" : "中"}</a>
    </nav>
  </header>

  <main>
    <section class="hero">
      <div class="hero__copy">
        <h1><span>Moyu Translate</span><br /><strong class="hero__lead">{copy.heroLead}</strong></h1>
        <p>{copy.heroBody}</p>
        <DownloadButtons manifest={manifest} lang={lang} client:load />
      </div>
      <HeroDemo lang={lang} client:visible />
    </section>

    <section class="manifest-strip" aria-label={zh ? "版本信息" : "Version information"}>
      <span>{manifest.version}</span><span>{zh ? "本地优先" : "Local-first"}</span><span>macOS + Windows</span><span>MIT</span>
    </section>

    <section class="feature-intro" id="features">
      <div><h2>{copy.featureTitle}</h2><p>{copy.featureBody}</p></div>
      <div class="feature-rail">
        <article><MousePointer2 /><h3>{zh ? "悬停即译" : "Hover to translate"}</h3><p>{zh ? "保留光标锚点，结果在附近出现。" : "The result appears beside your original cursor."}</p></article>
        <article><ScanText /><h3>{zh ? "无需选中" : "No selection"}</h3><p>{zh ? "辅助功能优先，局部 OCR 自动回退。" : "Accessibility first, local OCR as fallback."}</p></article>
        <article><LockKeyhole /><h3>{zh ? "离线运行" : "Works offline"}</h3><p>{zh ? "词典、发音入口与模型留在本机，不上传查询。" : "Dictionaries, pronunciation controls and models stay on your device."}</p></article>
      </div>
    </section>

    <section class="scenarios" id="scenarios">
      <div class="section-heading"><h2>{zh ? "每一种屏幕，都是同一个动作" : "One gesture across every screen"}</h2><p>{zh ? "从可访问文本到画面文字，Moyu 自动选择最合适的本地读取方式。" : "From accessible text to pixels, Moyu selects the right local capture path."}</p></div>
      <div class="scenario-grid">
        <article class="scenario scenario--reading"><BookOpen /><h3>{zh ? "文章与 PDF" : "Articles and PDFs"}</h3><p>{zh ? "读论文时快速看懂术语，不离开当前段落。" : "Understand a term without leaving the paragraph."}</p></article>
        <article class="scenario scenario--video"><MonitorPlay /><h3>{zh ? "视频字幕" : "Video subtitles"}</h3><p>{zh ? "暂停一秒，在原字幕旁查看含义。" : "Pause briefly and read the meaning beside the subtitle."}</p></article>
        <article class="scenario scenario--image"><Image /><h3>{zh ? "图片与海报" : "Images and posters"}</h3><p>{zh ? "局部 OCR 只读取光标周围。" : "Local OCR reads only around the cursor."}</p></article>
        <article class="scenario scenario--game"><Gamepad2 /><h3>{zh ? "游戏与全屏" : "Games and fullscreen"}</h3><p>{zh ? "支持窗口和无边框全屏；受保护内容除外。" : "Works in windowed and borderless fullscreen modes."}</p></article>
      </div>
    </section>

    <section class="dictionary-section" id="dictionary">
      <div class="dictionary-copy">
        <h2>{zh ? "先给答案，再给深度" : "The answer first. Depth when needed."}</h2>
        <p>{zh ? "25 万条结构化词条把最常用释义放在第一眼。UK / US 音标、手动朗读、词形、例句和同反义词按需展开，信息多但不拥挤。" : "250,000 structured entries put the common meaning first. UK / US IPA, manual speech, forms, examples and relations unfold only when you need them."}</p>
        <ul><li><Volume2 />{zh ? "自动美音 + 手动英美双音" : "Auto US speech + manual UK/US"}</li><li><Star />{zh ? "生词本卡片复习与可选历史" : "Vocabulary flashcards and opt-in history"}</li></ul>
      </div>
      <div class="dictionary-preview">
        <div class="dictionary-preview__head"><strong>ability</strong><button type="button" aria-label="US pronunciation"><Volume2 /></button></div>
        <div class="dictionary-preview__pronunciations"><span><b>UK</b> /əˈbɪləti/</span><span><b>US</b> /əˈbɪləti/</span></div>
        <div class="dictionary-preview__meaning"><b>n.</b><p>能力；才能</p></div>
        <div class="dictionary-preview__tags"><span>Oxford 3000</span><span>IELTS</span><span>TOEFL</span></div>
        <div class="dictionary-preview__row"><span>更多释义</span><small>2</small></div>
        <div class="dictionary-preview__row"><span>词形与例句</span><small>4</small></div>
        <footer>Moyu 离线词典 · 38ms</footer>
      </div>
    </section>

    <section class="privacy-section" id="privacy">
      <div class="privacy-mark"><MoyuMark /></div>
      <div><h2>{zh ? "查过什么，只留在你的电脑" : "What you look up stays on your computer"}</h2><p>{zh ? "Moyu 不需要账户，不保存云端历史，也不把屏幕截图发给服务器。查询历史默认关闭，生词、复习进度与模型都可以随时删除。" : "Moyu needs no account, stores no cloud history and never sends screenshots to a server. History is off by default, and vocabulary, review progress and models remain removable."}</p></div>
    </section>

    <section class="steps-section">
      <div class="section-heading"><h2>{zh ? "三步开始" : "Start in three steps"}</h2></div>
      <ol><li><span>1</span><div><h3>{zh ? "安装" : "Install"}</h3><p>{zh ? "从 GitHub Release 下载对应系统版本。" : "Download your platform build from GitHub Releases."}</p></div></li><li><span>2</span><div><h3>{zh ? "授权" : "Allow"}</h3><p>{zh ? "按系统提示开启取词和屏幕读取权限。" : "Enable text capture and screen permissions when prompted."}</p></div></li><li><span>3</span><div><h3>{zh ? "停住光标" : "Hover"}</h3><p>{zh ? "长按 Option 或 Alt，继续原来的事情。" : "Hold Option or Alt, then keep going."}</p></div></li></ol>
    </section>

    <section class="download-section" id="download">
      <div><h2>{zh ? "让不认识的词，不再打断你" : "Keep unknown words from breaking your flow"}</h2><p>{zh ? `当前 ${manifest.version} · 免费开源 · 本地优先` : `Current ${manifest.version} · Free and open source · Local-first`}</p></div>
      <DownloadButtons manifest={manifest} lang={lang} compact client:load />
    </section>

    <section class="faq-section">
      <div class="section-heading"><h2>{zh ? "常见问题" : "Questions"}</h2></div>
      <details><summary>{zh ? "真的可以完全离线吗？" : "Does it really work offline?"}</summary><p>{zh ? "词典无需下载模型即可使用。句子翻译首次下载语言包后可断网运行。" : "The dictionary works immediately. Sentence translation works offline after the first language-pack download."}</p></details>
      <details><summary>{zh ? "Windows 为什么会显示安全提示？" : "Why does Windows show a security warning?"}</summary><p>{zh ? "Beta 尚未购买正式代码签名证书，请只从本仓库 Release 下载并核对 SHA-256。" : "The beta is not yet signed with a commercial certificate. Download only from this repository and verify SHA-256."}</p></details>
      <details><summary>{zh ? "会内置牛津或剑桥词典吗？" : "Does it bundle Oxford or Cambridge dictionaries?"}</summary><p>{zh ? "不会未经许可打包商业词典正文。Oxford 3000 等仅作为词汇标签显示。" : "No commercial dictionary text is redistributed without permission. Oxford 3000 is shown only as a vocabulary-list tag."}</p></details>
    </section>
  </main>

  <footer class="site-footer">
    <a class="brand" href={root}><MoyuMark /><strong>Moyu Translate</strong></a>
    <div><a href="https://github.com/l3263254135-dotcom/Moyu-Translate">GitHub</a><a href="https://github.com/l3263254135-dotcom/Moyu-Translate/issues">{zh ? "反馈" : "Feedback"}</a><a href={withBase(base, zh ? "guide" : "en/guide")}>{zh ? "教程" : "Guide"}</a></div>
    <small>MIT · © 2026 Moyu Translate</small>
  </footer>
</BaseLayout>
